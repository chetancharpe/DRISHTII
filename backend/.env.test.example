# GoWow Backend - Automated Testing Environment Template
ENVIRONMENT=test
DEBUG=False
LOG_LEVEL=WARNING

# Dedicated Test Database (Isolated from dev and prod)
DATABASE_URL=sqlite:///./gowow_test.db
# Or PostgreSQL test instance:
# DATABASE_URL=postgresql://gowow_test_user:gowow_test_pass@localhost:5433/gowow_test_db

# Security & Tokens
JWT_SECRET_KEY=test_insecure_jwt_secret_key_minimum_64_characters_long_for_test_suite_runs_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173

# Rate Limiting (Relaxed for automated testing)
RATE_LIMIT_PER_MINUTE=1000
AUTH_RATE_LIMIT_PER_MINUTE=500

SUBMISSION_GRACE_PERIOD_SECONDS=30
