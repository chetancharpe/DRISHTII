# GoWow Backend - Production Environment Template
# CRITICAL: Populate via cloud secret manager (AWS Secrets Manager, GCP Secret Manager, or HashiCorp Vault)
# NEVER commit the active .env.production file to version control.

ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Production PostgreSQL Database with SSL & dedicated non-superuser credentials
# Format: postgresql://<app_user>:<strong_password>@<internal_db_host>:5432/<db_name>?sslmode=require
DATABASE_URL=postgresql://gowow_app_user:CHANGE_ME_IN_PRODUCTION_STRONG_PASSWORD@db.internal:5432/gowow_prod_db?sslmode=require

# High-Entropy Cryptographic Secret (Must be 32+ characters. Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_VIA_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backing Store for Distributed Rate Limiting (Redis Recommended for Production)
# REDIS_URL=redis://redis.internal:6379/0
EXAM_AUTOSAVE_RATE_LIMIT_PER_MINUTE=300

# Explicit Whitelisted Production Origins (NO WILDCARDS)
CORS_ORIGINS=https://app.gowow.org,https://gowow.org

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Security & Transit Buffer
SUBMISSION_GRACE_PERIOD_SECONDS=30
BACKUP_RETENTION_DAYS=30
HSTS_SECONDS=31536000
