# GoWow Examination Platform - Environment Configuration

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://gowow_user:gowow_secure_password@localhost:5432/gowow_db
# For SQLite testing fallback: sqlite:///./gowow.db

# JWT Security (Must be at least 32 characters. Generate using: openssl rand -hex 32)
# If empty in development, an ephemeral secret will be auto-generated at startup.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Redis (Optional backing store; in-memory sliding window by default)
# REDIS_URL=redis://localhost:6379/0
EXAM_AUTOSAVE_RATE_LIMIT_PER_MINUTE=300

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Development Seed Credentials (DO NOT USE IN PRODUCTION)
DEV_ADMIN_EMAIL=admin@gowow.org
DEV_ADMIN_PASSWORD=AdminSecurePass123!
DEV_EXAMINER_EMAIL=examiner@gowow.org
DEV_EXAMINER_PASSWORD=ExaminerSecure123!
DEV_CANDIDATE_EMAIL=candidate1@gowow.org
DEV_CANDIDATE_PASSWORD=CandidateSecure123!

# Server authorative time buffer (seconds to allow network transit on submit)
SUBMISSION_GRACE_PERIOD_SECONDS=30
