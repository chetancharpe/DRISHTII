# GoWow Backend - Development Environment Template
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG

# Database Configuration (Development PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./gowow.db
# For local Docker postgres:
# DATABASE_URL=postgresql://gowow_dev_user:gowow_dev_pass@localhost:5432/gowow_dev_db

# Security & Tokens
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_minimum_64_characters_long_for_gowow_local_testing_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Submission Transit Buffer (Seconds)
SUBMISSION_GRACE_PERIOD_SECONDS=30

# Dev Seed Credentials
DEV_ADMIN_EMAIL=admin@gowow.org
DEV_ADMIN_PASSWORD=AdminSecurePass123!
DEV_EXAMINER_EMAIL=examiner@gowow.org
DEV_EXAMINER_PASSWORD=ExaminerSecure123!
DEV_CANDIDATE_EMAIL=candidate1@gowow.org
DEV_CANDIDATE_PASSWORD=CandidateSecure123!
